  "datasources": [
    {
      "datasourceId": "ds-001",
      "datasourceName": "销售数据库",
      "datasourceType": "mysql",
      "connectionConfig": {
        "host": "localhost",
        "port": 3306,
        "database": "sales_db",
        "username": "readonly_user",
        "password": "encrypted_password"
      },
      "queryConfig": {
        "sql": "SELECT date, product, amount, quantity FROM sales_data WHERE date >= ? AND date <= ? ORDER BY date DESC",
        "parameters": [
          {
            "name": "startDate",
            "type": "date",
            "source": "control",
            "sourceId": "comp-004"
          },
          {
            "name": "endDate",
            "type": "date",
            "source": "control",
            "sourceId": "comp-004"
          }
        ],
        "fieldMapping": {
          "date": "date",
          "product": "product",
          "amount": "amount",
          "quantity": "quantity"
        }
      }
    }
