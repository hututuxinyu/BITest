      "position": {
        "x": 1400,
        "y": 100
      },
      "size": {
        "width": 300,
        "height": 50
      },
      "zIndex": 2,
      "visible": true,
      "locked": false,
      "props": {
        "type": "dateRange",
        "label": "a18i:label",
        "format": "YYYY-MM-DD",
        "defaultValue": null
      },
      "i18n": {
        "zh-CN": {
          "label": "选择日期范围"
        },
        "en-US": {
          "label": "Select Date Range"
        }
      }
