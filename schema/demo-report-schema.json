      "componentName": "表格",
      "position": {
        "x": 100,
        "y": 550
      },
      "size": {
        "width": 1250,
        "height": 400
      },
      "zIndex": 1,
      "visible": true,
      "locked": false,
      "props": {
        "title": "a18i:title",
        "columns": [
          {
            "field": "date",
            "title": "日期",
            "width": 120
          },
          {
            "field": "product",
            "title": "产品",
            "width": 150
          },
          {
            "field": "amount",
            "title": "销售额",
            "width": 120,
            "format": "number"
          },
          {
            "field": "quantity",
            "title": "数量",
            "width": 100
          }
        ],
        "pagination": {
          "pageSize": 20,
          "showSizeChanger": true
        }
      },
      "datasourceId": "ds-001",
      "i18n": {
        "zh-CN": {
          "title": "销售明细"
        },
        "en-US": {
          "title": "Sales Details"
        }
      }
