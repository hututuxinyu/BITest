  "datasources": [
    {
      "datasourceId": "ds-001",
      "datasourceName": "销售数据集",
      "datasourceType": "mysql",
      "datasetName": "销售数据集",
      "queryConfig": {
        "selectedFields": [
          {
            "fieldName": "date",
            "fieldLabel": "日期",
            "fieldType": "date",
            "tag": "dimension"
          },
          {
            "fieldName": "product",
            "fieldLabel": "产品",
            "fieldType": "string",
            "tag": "dimension"
          },
          {
            "fieldName": "amount",
            "fieldLabel": "销售额",
            "fieldType": "number",
            "tag": "measure"
          },
          {
            "fieldName": "quantity",
            "fieldLabel": "数量",
            "fieldType": "number",
            "tag": "measure"
          }
        ]
      },
      "filters": [
        {
          "field": "queryConfig:fieldName",
          "operator": "between",
          "sourceId": "comp-004",
          "valuePath": "value"
        }
      ],
      "parameters": {
        "startDate": "${value[0]}",
        "endDate": "${value[1]}"
      }
    }
  ],
  "interactions": [
    {
      "componentId": "comp-004",
      "events": [
