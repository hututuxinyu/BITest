    },
    {
      "componentId": "comp-002",
      "componentType": "lineChart",
      "componentName": "折线图",
      "position": {
        "x": 750,
        "y": 100
      },
      "size": {
        "width": 600,
        "height": 400
      },
      "zIndex": 1,
      "visible": true,
      "locked": false,
      "props": {
        "title": "i18n:title",
        "xAxisField": "date",
