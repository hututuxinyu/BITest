      },
      "size": {
        "width": 600,
        "height": 400
      },
      "zIndex": 1,
      "props": {
        "title": "i18n:title",
        "xAxisField": "month",
        "yAxisField": "amount",
        "color": "#1890ff",
        "showLegend": true,
        "showTooltip": true
      },
      "datasourceId": "ds-001",
      "i18n": {
        "zh-CN": {
          "title": "月度销售额"
        },
        "en-US": {
          "title": "Monthly Sales"
        }
