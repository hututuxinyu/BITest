              "target": "comp-001",
              "params": {
                "startDate": "${value[0]}",
                "endDate": "${value[1]}"
              }
            },
            {
              "actionType": "filter",
              "target": "comp-002",
              "params": {
                "startDate": "${value[0]}",
                "endDate": "${value[1]}"
              }
            },
            {
              "actionType": "filter",
              "target": "comp-003",
              "params": {
                "startDate": "${value[0]}",
                "endDate": "${value[1]}"
              }
